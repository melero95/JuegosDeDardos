<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="Base.Theme.JuegosDeDardos"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Color principal de la aplicación -->
        <item name="colorPrimary">@color/blue</item>

        <!-- Permite colorear las barras del sistema -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Barra de estado superior -->
        <item name="android:statusBarColor">@color/blue</item>

        <!-- Barra de navegación inferior -->
        <item name="android:navigationBarColor">@color/blue</item>

        <!-- Evita una línea divisoria de otro color -->
        <item name="android:navigationBarDividerColor">@color/blue</item>

        <!-- Iconos claros en la barra superior -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Iconos claros en la barra inferior -->
        <item name="android:windowLightNavigationBar">false</item>

    </style>

    <style name="Theme.JuegosDeDardos"
        parent="Base.Theme.JuegosDeDardos" />

    <style name="BotonPrincipal">
        <item name="android:backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">20sp</item>
    </style>

</resources>